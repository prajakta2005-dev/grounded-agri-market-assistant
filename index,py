"""Small standalone check for the NVIDIA OpenAI-compatible vision endpoint.

Set NVIDIA_API_KEY in the environment before running this script. Never commit
the key or put it in frontend code.
"""

import os

from openai import OpenAI


client = OpenAI(
    base_url=os.getenv("NVIDIA_BASE_URL", "https://integrate.api.nvidia.com/v1"),
    api_key=os.environ["NVIDIA_API_KEY"],
)

completion = client.chat.completions.create(
    model=os.getenv("NVIDIA_MODEL", "nvidia/nemotron-3.5-super-vl-120b-a12b"),
    messages=[
        {
            "role": "user",
            "content": [
                {"type": "text", "text": "Describe the visible crop symptoms."},
                {
                    "type": "image_url",
                    "image_url": {
                        "url": "https://assets.ngc.nvidia.com/products/api-catalog/phi-3-5-vision/example1a.jpg"
                    },
                },
            ],
        }
    ],
    temperature=0.3,
    max_tokens=2048,
    stream=True,
)

for chunk in completion:
    if chunk.choices and chunk.choices[0].delta.content:
        print(chunk.choices[0].delta.content, end="")
